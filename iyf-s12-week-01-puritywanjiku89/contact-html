<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact — YOUR NAME HERE</title>
</head>
<body>

    <header>
        <a href="/">My Site</a>
        <nav aria-label="Main">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/contact.html" aria-current="page">Contact</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1>Contact me</h1>

        <form action="#" method="post">
            
            <!-- STEP 7 -->
            <fieldset>
                <legend>About you</legend>

                <label for="full-name">Full name</label>
                <input type="text" id="full-name" name="full-name" required placeholder="e.g. Amina Otieno">

                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>

                <label for="phone">Phone</label>
                <input type="tel" id="phone" name="phone">
            </fieldset>

            <!-- STEP 8 -->
            <fieldset>
                <legend>Your message</legend>

                <label for="subject">Subject</label>
                <select id="subject" name="subject" required>
                    <option value="">Choose a subject</option>
                    <option value="general">General Inquiry</option>
                    <option value="support">Support</option>
                    <option value="feedback">Feedback</option>
                </select>

                <label for="message">Message</label>
                <textarea id="message" name="message" rows="6" required minlength="50"></textarea>

                <input type="checkbox" id="newsletter" name="newsletter">
                <label for="newsletter">Subscribe to newsletter</label>
            </fieldset>

            <!-- STEP 9 -->
            <button type="submit">Send message</button>

        </form>
    </main>

    <!-- STEP 10 - same as other page -->
    <footer>
        <small>© 2026</small>
    </footer>

</body>
</html>
